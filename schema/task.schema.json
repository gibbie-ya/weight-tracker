{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gibbie-ya/weight-tracker/schema/task.schema.json",
  "title": "BrainDumpTaskArray",
  "description": "Array of actionable tasks extracted from a brain-dump by the Claude structuring prompt.",
  "type": "array",
  "items": {
    "type": "object",
    "title": "Task",
    "required": ["title", "notes", "due"],
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "description": "Short imperative action phrase, max 60 characters.",
        "minLength": 1,
        "maxLength": 60
      },
      "notes": {
        "type": "string",
        "description": "Supporting context or detail. Empty string if none."
      },
      "due": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 date YYYY-MM-DD."
          },
          {
            "type": "null",
            "description": "No due date inferable."
          }
        ]
      }
    }
  }
}
